#!/bin/sh
set -f
if [ "${CODIUM_BYPASS_SHIMS:-0}" = 1 ]; then
    if [ -x /usr/bin/npm ]; then exec /usr/bin/npm "$@"; fi
    printf '%s\n' '[codium-shim] native npm is unavailable; install npm or use pnpm.' >&2
    exit 127
fi
if [ "$#" -eq 0 ]; then exec /usr/bin/pnpm install; fi
case "$1" in
    -v|--version)
        version=$(/usr/bin/npm --version 2>/dev/null || printf '%s' unknown)
        pnpm_version=$(/usr/bin/pnpm --version 2>/dev/null || printf '%s' unknown)
        printf '%s (codium npm shim -> pnpm %s)\n' "$version" "$pnpm_version"
        exit 0
        ;;
    -h|--help) exec /usr/bin/pnpm --help ;;
    publish|login|adduser|logout|doctor|config)
        printf '[codium-shim] npm %s is unsupported. Use pnpm directly when available or npm-native/CODIUM_BYPASS_SHIMS=1 for native npm.\n' "$*" >&2
        exit 1
        ;;
    audit)
        case "${2:-}" in
            fix) printf '[codium-shim] npm audit fix is unsupported. Use pnpm audit or npm-native audit fix.\n' >&2; exit 1;;
            *) exec /usr/bin/pnpm audit "$@";;
        esac
        ;;
    install|i)
        shift
        has_package=0
        after_options=0
        for arg do
            if [ "$after_options" -eq 1 ]; then
                has_package=1
                break
            fi
            case "$arg" in
                --) after_options=1 ;;
                -*) ;;
                *) has_package=1; break ;;
            esac
        done
        if [ "$has_package" -eq 0 ]; then exec /usr/bin/pnpm install "$@"; fi
        exec /usr/bin/pnpm add "$@"
        ;;
    uninstall|remove|rm|r|unlink) shift; exec /usr/bin/pnpm remove "$@" ;;
    update|up) shift; exec /usr/bin/pnpm update "$@" ;;
    run|run-script) shift; exec /usr/bin/pnpm run "$@" ;;
    test|t) shift; exec /usr/bin/pnpm test "$@" ;;
    exec|list|ls|why|explain|init|create|outdated|prune|root|bin|start|stop|restart) exec /usr/bin/pnpm "$@" ;;
    add) exec /usr/bin/pnpm "$@" ;;
    *)
        printf '[codium-shim] npm %s is unsupported. Use pnpm or npm-native/CODIUM_BYPASS_SHIMS=1 for native npm.\n' "$*" >&2
        exit 1
        ;;
esac
