#!/bin/sh
set -f
if [ "${CODIUM_BYPASS_SHIMS:-0}" = 1 ]; then
    if [ -x /usr/bin/yarn ]; then exec /usr/bin/yarn "$@"; fi
    printf '%s\n' '[codium-shim] native yarn is unavailable; use pnpm.' >&2
    exit 127
fi
if [ "$#" -eq 0 ]; then exec /usr/bin/pnpm install; fi
case "$1" in
    -v|--version)
        version=$(/usr/bin/yarn --version 2>/dev/null || printf '%s' unknown)
        pnpm_version=$(/usr/bin/pnpm --version 2>/dev/null || printf '%s' unknown)
        printf '%s (codium yarn shim -> pnpm %s)\n' "$version" "$pnpm_version"
        exit 0
        ;;
    -h|--help) exec /usr/bin/pnpm --help ;;
    set|plugin|policies|publish|login|dlx)
        printf '[codium-shim] yarn %s is unsupported. Use pnpm or yarn-native/CODIUM_BYPASS_SHIMS=1 for native Yarn.\n' "$*" >&2
        exit 1
        ;;
    install) shift; exec /usr/bin/pnpm install "$@" ;;
    add|remove)
        verb=$1
        shift
        if [ "${1:-}" = -W ]; then shift; exec /usr/bin/pnpm "$verb" -w "$@"; fi
        exec /usr/bin/pnpm "$verb" "$@"
        ;;
    upgrade) shift; exec /usr/bin/pnpm update "$@" ;;
    upgrade-interactive) shift; exec /usr/bin/pnpm update -i "$@" ;;
    run) shift; exec /usr/bin/pnpm run "$@" ;;
    test) shift; exec /usr/bin/pnpm test "$@" ;;
    create|why) exec /usr/bin/pnpm "$@" ;;
    *)
        printf '[codium-shim] yarn %s is unsupported. Use pnpm or yarn-native/CODIUM_BYPASS_SHIMS=1 for native Yarn.\n' "$*" >&2
        exit 1
        ;;
esac
